{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    // Core is host-agnostic, but it does lean on globals that TypeScript only
    // declares in the DOM lib — structuredClone, setTimeout, WebCrypto. All
    // three exist in UXP, browsers and Node 20+; no DOM API is used.
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
