{
  "manifestVersion": 5,
  "id": "com.vaporswift.throughline",
  "name": "Throughline",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "throughline.panel",
      "label": {
        "default": "Throughline"
      },
      "minimumSize": { "width": 300, "height": 320 },
      "maximumSize": { "width": 2400, "height": 2400 },
      "preferredDockedSize": { "width": 360, "height": 720 },
      "preferredFloatingSize": { "width": 440, "height": 820 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": false,
    "clipboard": "readAndWrite"
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/light.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/dark.png",
      "scale": [1, 2],
      "theme": ["dark", "darkest"]
    }
  ]
}
